# ─────────────────────────────────────────────────────────────────────────────
#  PROPEL — environment configuration
#
#  Copy to `.env.local` for development, and set the same values in your hosting
#  provider's environment variables for production.
#
#  The two marked REQUIRED will hard-fail a production build if left unset —
#  a site with a dead WhatsApp link is worse than a site that failed to deploy.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — canonical origin, no trailing slash.
# Drives canonical URLs, hreflang, the sitemap and Open Graph tags.
# No trailing slash. Must be the real origin - the production guard fails a
# deploy that still carries the REPLACE-ME.invalid sentinel.
NEXT_PUBLIC_SITE_URL=https://propel.co.il

# REQUIRED — WhatsApp number in international format, digits only, no + or spaces.
# Every call-to-action on the site links to this.
NEXT_PUBLIC_WHATSAPP_PHONE=972501234567

# Shown in the footer and used as the tel: link. Formatted for humans.
NEXT_PUBLIC_PHONE_DISPLAY=

# Public contact address, shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# Where the contact form delivers. Server-side only — never exposed to the browser.
CONTACT_INBOX_EMAIL=

# Registered business name and number. B2B buyers look for these.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_ID=

# Named accessibility coordinator — required by Israeli accessibility regulations
# to appear on the accessibility statement page.
NEXT_PUBLIC_A11Y_CONTACT_NAME=

# Last review date of the legal pages (ISO). Update when you revise them.
NEXT_PUBLIC_LEGAL_UPDATED=2026-07-27

# ── Contact form delivery ─────────────────────────────────────────────────────
# Nothing to set. The form posts to Netlify Forms, which stores every submission
# and emails it on; the destination is configured in the Netlify UI under
# Forms > Form notifications, not here. The Resend variables that used to live
# in this block were removed with the provider.
