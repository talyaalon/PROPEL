# ─────────────────────────────────────────────────────────────────────────────
#  PROPEL — environment configuration
#
#  Copy to `.env.local` for development, and set the same values in your hosting
#  provider's environment variables for production.
#
#  The two marked REQUIRED will hard-fail a production build if left unset —
#  a site with a dead WhatsApp link is worse than a site that failed to deploy.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — canonical origin, no trailing slash.
# Drives canonical URLs, hreflang, the sitemap and Open Graph tags.
# No trailing slash. Must be the real origin - the production guard fails a
# deploy that still carries the REPLACE-ME.invalid sentinel.
NEXT_PUBLIC_SITE_URL=https://propel.co.il

# ── Contact ───────────────────────────────────────────────────────────────────
#
# There is deliberately NO phone variable here any more.
#
# NEXT_PUBLIC_PHONE_DISPLAY and NEXT_PUBLIC_WHATSAPP_PHONE used to live in this
# block and are now ignored by the code. They were two independent variables
# describing one number, they drifted, and the live site spent three deploys
# serving one number on `tel:` and a different one on WhatsApp.
#
# The number is committed in src/lib/config.ts as `PHONE_RAW`, and the display,
# dial and WhatsApp forms are all derived from it. To change it, edit that line.
#
# If either variable is still set in your hosting dashboard, DELETE IT - it no
# longer has any effect, and leaving it there invites the same confusion again.

# Public contact address, shown in the footer and in the JSON-LD.
#
# No default, on purpose. hello@propel.co.il needs MX records and a live mailbox
# before it can receive anything, and an address that bounces is worse than no
# address: the sender believes they got through. While this is unset the email
# row simply does not render, and the page offers WhatsApp, phone and the form.
# Set it once the mailbox actually answers.
NEXT_PUBLIC_CONTACT_EMAIL=hello@propel.co.il

# Where the contact form delivers. Server-side only — never exposed to the browser.
CONTACT_INBOX_EMAIL=

# Registered business name and number. B2B buyers look for these.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_ID=

# Named accessibility coordinator — required by Israeli accessibility regulations
# to appear on the accessibility statement page.
NEXT_PUBLIC_A11Y_CONTACT_NAME=

# Search Console ownership token - the `content` value from the HTML-tag
# verification method (the token alone, not the whole tag). Renders a
# google-site-verification meta on every page. Not a secret.
NEXT_PUBLIC_GSC_VERIFICATION=

# GA4 measurement id (G-XXXXXXXXXX). Optional - with it unset, no analytics
# script is rendered and no request leaves the page. The click instrumentation
# is already wired: every CTA's data-analytics attribute is forwarded to gtag
# the moment this exists.
NEXT_PUBLIC_GA4_ID=

# Last review date of the legal pages (ISO). Update when you revise them.
NEXT_PUBLIC_LEGAL_UPDATED=2026-07-27

# ── Contact form delivery ─────────────────────────────────────────────────────
# Nothing to set. The form posts to Netlify Forms, which stores every submission
# and emails it on; the destination is configured in the Netlify UI under
# Forms > Form notifications, not here. The Resend variables that used to live
# in this block were removed with the provider.
